/vendor/
/.env
# database.yaml sollte ohnehin außerhalb des Projekts liegen (siehe README) —
# dieser Eintrag ist nur eine zusätzliche Absicherung, falls sie versehentlich
# doch im Projektordner landet.
/database.yaml
/storage/uploads/*
# PHP-Sitzungen (Session-Timeout, siehe App\Infrastructure\Http\Auth\SessionTimeout)
/storage/sessions/
!/storage/uploads/.gitkeep
!/storage/uploads/articles/.gitkeep
!/storage/uploads/rma/.gitkeep
/node_modules/
.DS_Store
var/phpstan/
# Test-Zugangsdaten (Kopie von tests/.env.testing.dist), von `codecept build`
# erzeugte Actor-Traits und Testausgaben
/tests/.env.testing
/tests/_support/_generated/
/tests/_output/*
!/tests/_output/.gitkeep
