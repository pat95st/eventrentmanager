# Vorlage für die Zugangsdaten der Acceptance-Test-Datenbank/-Instanz.
#
# Kopieren nach tests/.env.testing (diese Kopie ist gitignored, siehe
# .gitignore) und mit echten Werten für die TEST-Umgebung befüllen — NIEMALS
# gegen die Produktivdatenbank laufen lassen, die Db-Modul-Konfiguration
# leert die konfigurierte Datenbank vor jedem Testlauf komplett und lädt sie
# aus database/schema.sql neu!
#
# APP_URL muss auf eine laufende Instanz der Anwendung zeigen, die GEGEN
# DIESELBE Datenbank läuft, z. B. über den PHP-Entwicklungsserver:
#   DATABASE_CONFIG_PATH=/pfad/zu/test-database.yaml php -S 127.0.0.1:8000 -t public router.php
# (test-database.yaml zeigt auf dieselben TEST_DB_*-Zugangsdaten wie unten).
APP_URL=http://127.0.0.1:8000

TEST_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=materialverleih_test;charset=utf8mb4
TEST_DB_USER=materialverleih_test
TEST_DB_PASSWORD=bitte-aendern
